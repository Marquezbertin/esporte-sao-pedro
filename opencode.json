{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": { "*": "ask", "git *": "allow", "grep *": "allow", "cat *": "allow", "ls *": "allow", "Get-*": "allow", "Select-*": "allow", "npm *": "allow", "pip *": "allow" }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": { "*": "deny", "git *": "allow", "grep *": "allow", "cat *": "allow", "ls *": "allow" }
      }
    }
  }
}